---
import Base from '../layouts/Base.astro';
import { AppProviders } from '../components/AppProviders';
import { LoginForm } from '../components/LoginForm';
---

<Base title="Iniciar Sesión">
  <div style="display: flex; justify-content: center; align-items: center; min-height: calc(100vh - 200px);">
    {/* AppProviders es la raíz de la isla de React en el cliente para el login */}
    <AppProviders client:only="react">
      <LoginForm />
    </AppProviders>
  </div>
</Base>

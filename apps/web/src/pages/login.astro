---
import Base from '../layouts/Base.astro';
import { LoginPage } from '../components/LoginPage';
---

<Base title="Iniciar Sesión">
  <div style="display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 100vh; padding: 2rem; background-color: var(--oat-bg);">
    <header style="margin-bottom: 2.5rem; text-align: center;">
      <h1 class="oat-text-bold" style="font-size: 2.5rem; margin: 0;">Dashboard</h1>
      <p class="oat-text-secondary">Bienvenido de nuevo.</p>
    </header>

    <div style="width: 100%; max-width: 400px;">
      <LoginPage client:only="react" />  <!-- ✅ Un solo punto de entrada React -->
    </div>
  </div>
</Base>

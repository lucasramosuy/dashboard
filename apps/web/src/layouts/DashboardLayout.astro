---
import { url } from "@/lib/utils";
import Base from "./Base.astro";
import { SidebarActions } from "../components/layout/SidebarActions";
import { MobileMenu } from "../components/layout/MobileMenu";
import { navItems } from "../config/nav";
import { Wordmark } from "../components/layout/Wordmark";

interface Props {
  title: string;
}

const { title } = Astro.props;
// Ruta sin el base ("/panel") para marcar el ítem activo del menú
const pathname =
  Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, "").length) || "/";
---

<Base title={title}>
  {/* Skip link — accesibilidad: visible al recibir foco por teclado */}
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-500 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-elevated focus:text-content focus:ring-2 focus:ring-zinc-900 dark:focus:bg-surface-dark dark:focus:text-content-dark dark:focus:ring-zinc-100"
  >
    Saltar al contenido principal
  </a>
  <div class="app-shell">
    <aside class="app-sidebar">
      <div class="sidebar-brand">
        <a href={url("/")} class="sidebar-brand-link" aria-label="panel. — inicio">
          <Wordmark />
        </a>
      </div>

      <nav class="sidebar-nav">
        {
          navItems.map(({ href, icon: Icon, label }) => (
            <a
              href={url(href)}
              class={`app-nav-link${(href === "/" ? pathname === "/" : pathname.startsWith(href)) ? " active" : ""}`}
            >
              <span class="sidebar-icon-item">
                <Icon size={18} strokeWidth={1.75} />
              </span>
              <span class="sidebar-label">{label}</span>
            </a>
          ))
        }
      </nav>

      {/* Desktop Sidebar Bottom */}
      <div class="sidebar-bottom">
        <SidebarActions client:only="react" variant="sidebar" />
      </div>
    </aside>

    {/* Barra superior + menú móvil */}
    <MobileMenu client:only="react" currentPath={pathname} />

    <main id="main-content" class="app-main">
      <slot />
    </main>
  </div>
</Base>

<style is:global>
  /* ===== SHELL ===== */
  .app-shell {
    display: flex;
    min-height: 100vh;
    background: var(--theme-bg);
  }

  @media (min-width: 769px) {
    .app-shell {
      padding-left: 15rem; /* 240px: sidebar fijo */
    }
  }

  /* ===== SIDEBAR ===== */
  .app-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 15rem;
    height: 100vh;
    background: var(--theme-bg);
    border-right: 1px solid var(--theme-border);
    padding: 1.75rem 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    overflow-y: auto;
    z-index: 40;
  }

  .wordmark {
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--theme-text);
    line-height: 1;
  }
  .wordmark-dot {
    color: var(--theme-accent);
  }

  .sidebar-brand {
    padding: 0 0.75rem;
    margin-bottom: 2rem;
  }
  .sidebar-brand-link {
    display: inline-block;
    font-size: 1.5rem;
    text-decoration: none;
  }

  /* Nav */
  .sidebar-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .app-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--theme-text-muted);
    font-weight: 500;
    font-size: 0.875rem;
    white-space: nowrap;
    transition:
      background 0.15s,
      color 0.15s;
  }

  /* Ítem activo: pill suave con tinte (sin barra lateral) */
  .app-nav-link.active {
    background: color-mix(in srgb, var(--theme-text) 8%, var(--theme-bg));
    color: var(--theme-text);
  }

  @media (hover: hover) {
    .app-nav-link:hover {
      background: color-mix(in srgb, var(--theme-text) 5%, var(--theme-bg));
      color: var(--theme-text);
    }
    .app-nav-link.active:hover {
      background: color-mix(in srgb, var(--theme-text) 8%, var(--theme-bg));
    }
  }

  /* Icon */
  .sidebar-icon-item {
    flex-shrink: 0;
    width: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Bottom */
  .sidebar-bottom {
    padding-top: 1rem;
    border-top: 1px solid var(--theme-border);
    margin-top: auto;
  }

  .sidebar-actions-container {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .profile-btn,
  .logout-btn,
  .theme-toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.625rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--theme-text-muted);
    font-family: inherit;
    font-weight: 500;
    font-size: 0.875rem;
    transition:
      background 0.15s ease,
      color 0.15s ease;
    cursor: pointer;
    background: transparent;
    border: none;
    text-align: left;
  }

  @media (hover: hover) {
    .profile-btn:hover,
    .logout-btn:hover,
    .theme-toggle-btn:hover {
      background: color-mix(in srgb, var(--theme-text) 5%, var(--theme-bg));
      color: var(--theme-text);
    }

    .logout-btn:hover {
      color: var(--theme-danger);
    }
  }

  /* ===== MAIN ===== */
  .app-main {
    flex: 1;
    min-width: 0;
    width: 100%;
    /* Llena el ancho en desktop; en pantallas enormes se limita para no estirar el texto */
    max-width: 1480px;
    margin: 0 auto;
    padding: 3rem 3rem 4rem;
    background: var(--theme-bg);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .app-sidebar {
      display: none !important;
    }

    .app-shell {
      flex-direction: column;
    }
    .app-main {
      padding: 1.5rem 1.25rem 3rem;
    }
  }
</style>

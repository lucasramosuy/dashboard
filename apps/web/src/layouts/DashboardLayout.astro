---
import Base from "./Base.astro";
import { SidebarActions } from "../components/SidebarActions";
import { MobileMenu } from "../components/MobileMenu";

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", icon: "🏠", label: "Dashboard" },
  { href: "/subjects", icon: "📚", label: "UC" },
  { href: "/tasks", icon: "✅", label: "Tareas" },
  { href: "/planner", icon: "📅", label: "Planner" },
  { href: "/journal", icon: "✍️", label: "Práctica" },
  { href: "/schoology", icon: "🔗", label: "Schoology" },
  { href: "/analytics", icon: "📊", label: "Analíticas" },
  { href: "/feedback", icon: "🐛", label: "Reportar Bug" },
];
---

<Base title={title}>
  <div class="app-shell">
    <aside class="app-sidebar">
      <div class="sidebar-brand">
        <span class="sidebar-icon-item">📚</span>
        <span class="sidebar-label sidebar-brand-text">Mi Panel</span>
      </div>

      <nav class="sidebar-nav">
        {
          navItems.map(({ href, icon, label }) => (
            <a href={href} class={`app-nav-link${pathname === href ? " active" : ""}`}>
              <span class="sidebar-icon-item">{icon}</span>
              <span class="sidebar-label">{label}</span>
            </a>
          ))
        }
      </nav>

      {/* Desktop Sidebar Bottom */}
      <div class="sidebar-bottom">
        <SidebarActions client:only="react" variant="sidebar" />
      </div>
    </aside>

    <main class="app-main">
      <slot />
    </main>

    {/* Menú flotante móvil (fase 8) */}
    <MobileMenu client:only="react" navItems={navItems} currentPath={pathname} />
  </div>
</Base>

<style is:global>
  /* ===== SHELL ===== */
  .app-shell {
    display: flex;
    min-height: 100vh;
    background: var(--theme-bg);
  }

  /* ===== SIDEBAR BENTO ===== */
  .app-sidebar {
    flex-shrink: 0;
    width: 72px;
    margin: 1rem 0 1rem 1rem;
    height: calc(100vh - 2rem);
    background: var(--theme-card-bg);
    border: 1px solid var(--theme-border);
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    padding: 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    overflow: hidden;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: sticky;
    top: 1rem;
    z-index: 40;
  }

  .app-sidebar:hover {
    width: 220px;
  }

  /* Brand */
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.375rem;
    margin-bottom: 1rem;
  }

  .sidebar-brand-text {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--theme-text);
    white-space: nowrap;
  }

  /* Nav */
  .sidebar-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .app-nav-link {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0.75rem 0.5rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--theme-text-muted);
    font-weight: 500;
    font-size: 0.875rem;
    white-space: nowrap;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .app-nav-link:hover,
  .app-nav-link.active {
    background: var(--theme-bg);
    color: var(--theme-text);
  }

  .app-nav-link.active {
    font-weight: 700;
  }

  /* Icon */
  .sidebar-icon-item {
    font-size: 1.25rem;
    flex-shrink: 0;
    width: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Labels */
  .sidebar-label {
    overflow: hidden;
    max-width: 0;
    opacity: 0;
    margin-left: 0;
    transition:
      max-width 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.15s ease,
      margin-left 0.2s ease;
  }

  .app-sidebar:hover .sidebar-label {
    max-width: 200px;
    opacity: 1;
    margin-left: 0.75rem;
  }

  /* Bottom */
  .sidebar-bottom {
    padding-top: 1rem;
    border-top: 1px solid var(--theme-border);
    overflow: hidden;
  }

  /* ===== MAIN ===== */
  .app-main {
    flex: 1;
    min-width: 0;
    padding: 2.5rem;
    background: var(--theme-bg);
  }

  /* ===== MOBILE ACTIONS (theme + logout) ===== */
  .mobile-actions {
    position: fixed;
    right: 1rem;
    bottom: calc(64px + 1rem); /* Por encima del bottom nav */
    display: none;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 60;
  }

  .mobile-theme-btn {
    display: none;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .app-sidebar {
      display: none !important;
    }

    .app-main {
      padding: 1.5rem 1rem;
      padding-bottom: 5rem; /* Space for the floating button */
    }
  }
</style>

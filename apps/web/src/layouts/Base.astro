---
import "../styles/theme.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Un panel académico personal para organizar tus unidades curriculares, tareas, inasistencias y prácticas docentes, con estadísticas claras y seguimiento del progreso a lo largo del semestre."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://unpkg.com/@knadh/oat/oat.min.css" />
    <link rel="canonical" href={`https://dashboard.lucasramos.uy${Astro.url.pathname}`} />
    <script src="https://unpkg.com/@knadh/oat/oat.min.js" defer is:inline></script>

    <script is:inline>
      const saved = localStorage.getItem("dash_theme");
      const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
      document.documentElement.dataset.theme = saved || preferred;
    </script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

---
import "../styles/theme.css";
import { Font } from "astro:assets";

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Un panel académico personal para organizar tus unidades curriculares, tareas, inasistencias y prácticas docentes, con estadísticas claras y seguimiento del progreso a lo largo del semestre."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <!-- App instalable (PWA): ícono en la pantalla de inicio y pantalla completa -->
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="panel." />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1214" media="(prefers-color-scheme: dark)" />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-dm-mono" preload />
    <link rel="canonical" href={`https://lucasramos.uy${Astro.url.pathname}`} />
    {/* Open Graph / Twitter: preview básica al compartir el enlace */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="panel." />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Un panel académico personal para organizar tus unidades curriculares, tareas, inasistencias y prácticas docentes."
    />
    <meta property="og:url" content={`https://lucasramos.uy${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      const saved = localStorage.getItem("dash_theme");
      const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
      document.documentElement.dataset.theme = saved || preferred;
    </script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

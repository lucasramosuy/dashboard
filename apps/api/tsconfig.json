{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@dashboard/shared-types": ["../../packages/shared-types/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "../../packages/shared-types/**/*"
  ]
}

# === REQUIRED ===
NODE_ENV=development

# Better Auth — requerido para que las sesiones, callbacks y redirects funcionen
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string-min-32-chars

# === OPTIONAL ===
# Turso (base remota, la que usa producción). Si no está, usa el SQLite local.
# `bun run migrate` con estas dos variables crea/actualiza las tablas en Turso.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# Local SQLite path (default: ./data/database.sqlite)
# DATABASE_PATH=./data/database.sqlite

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:4321
# Sentry (opcional; si no está, usa el DSN por defecto del proyecto)
# SENTRY_DSN=

# === REQUIRED ===
JWT_SECRET=change-me-to-a-secure-random-string
NODE_ENV=development

# === OPTIONAL ===
# Turso (remote DB) — if not set, uses local SQLite file
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# Local SQLite path (default: ./data/test.sqlite)
# DATABASE_PATH=./data/test.sqlite

# Enable demo login (set to "true" only in dev)
DEV_LOGIN_ENABLED=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:4321,http://100.96.131.5:4321
SENTRY_BUN_DSN=""
SENTRY_HONO_DSN=""
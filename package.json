{
  "name": "dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "agentation": "^2.3.3",
    "concurrently": "^8.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1"
  },
  "scripts": {
    "dev:web": "cd apps/web && bun run dev",
    "dev:api": "cd apps/api && bun run dev",
    "dev": "bunx concurrently \"bun run dev:web\" \"bun run dev:api\"",
    "build:web": "cd apps/web && bun run build",
    "build:api": "cd apps/api && bun run build",
    "build": "bun run build:api && bun run build:web",
    "start:api": "cd apps/api && bun run start",
    "preview:web": "cd apps/web && bun run preview",
    "test": "cd apps/api && bun test",
    "test:watch": "cd apps/api && bun test --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "bun run lint && bun run check:api && bun run check:web",
    "check:api": "cd apps/api && bun run check",
    "check:web": "cd apps/web && bun run check"
  }
}
